app "E-Renty" id=dev.era.erenty version=0.1.0 start=Splash
icon "Images/app_icon.png" background=primary(#00E6B5)
skin Renty
  colors accent=#00D9A4 background=#F7FAF7 bar=#E3E9E3 border=#EEF2EE brand=#01EDB9 danger=#D93036 disabled=#E3E9E3 focus=#5BE39C hero=#0C473E hero_alt=#545454 info=#0B71D7 info_soft=#E6EEF4 ink=#000000 mint=#DCFBF1 mint_soft=#EBFEFA muted=#667370 on_dark=#FFFFFF on_dark_muted=#D8E6E2 on_primary=#143132 placeholder=#C1CAC8 primary=#00E6B5 secondary=#005B45 success=#2E9E5B surface=#FFFFFF text=#143132 warning=#F5A623 warning_text=#A15C00
  spacing lg=20 md=12 sm=8 xl=32 xs=4
  radius lg=22 md=16 pill=999 sm=10 xl=28
  border thick=2 thin=1
  elevation md=8 sm=2
  font "Inter" files=[Assets/Fonts/Inter-Bold.ttf, Assets/Fonts/Inter-Medium.ttf, Assets/Fonts/Inter-Regular.ttf, Assets/Fonts/Inter-SemiBold.ttf]
  style badge size=12 weight=600 line_height=14
  style body size=16 weight=400 line_height=22
  style body_strong size=16 weight=500 line_height=22
  style button size=16 weight=500 line_height=20
  style caption size=13 weight=400 line_height=18
  style caption_strong size=13 weight=500 line_height=18
  style code size=36 weight=500 line_height=40
  style display size=32 weight=500 line_height=38 tracking=-0.6
  style heading size=28 weight=500 line_height=34 tracking=-0.4
  style label size=15 weight=500 line_height=20
  style subhead size=15 weight=400 line_height=20
  style title size=17 weight=500 line_height=22
  style title_lg size=20 weight=500 line_height=26
screen Home title="Overview" background=background(#F7FAF7)
  column {height=fill width=fill} @Home
    scroll {direction=vertical height=fill} @Home/0
      column {gap=lg(20) padding=lg(20) width=fill} @Home/0/0
        row {distribute=between width=fill} @Home/0/0/0
          stack {align=center background=surface(#FFFFFF) elevation=sm(2) height=44 on_press=[go Menu] radius=md(16) width=44} @Home/0/0/0/0:IconTile <IconTile>
            icon "Icons/grid.svg" {color=text(#143132) size=20} @Home/0/0/0/0:IconTile/0 <IconTile>
          stack {align=center background=surface(#FFFFFF) elevation=sm(2) height=44 radius=md(16) width=44} @Home/0/0/0/1:IconTile <IconTile>
            icon "Icons/bell.svg" {color=text(#143132) size=20} @Home/0/0/0/1:IconTile/0 <IconTile>
        row @Home/0/0/1
          text "Good morning, " {color=text(#143132) style=heading} @Home/0/0/1/0
          text "Rehan" {color=accent(#00D9A4) style=heading} @Home/0/0/1/1
          text "." {color=text(#143132) style=heading} @Home/0/0/1/2
        scroll {direction=horizontal} @Home/0/0/2
          row {gap=md(12)} @Home/0/0/2/0
            column {visible=Session.needs_verification} @Home/0/0/2/0/0
              column {background=hero(#0C473E) distribute=between height=150 on_press=[go VerifyCode] padding=md(12) radius=xl(28) width=220} @Home/0/0/2/0/0/0:HeroCard <HeroCard>
                column {gap=xs(4)} @Home/0/0/2/0/0/0:HeroCard/0 <HeroCard>
                  text "Identity verification required" {color=on_dark(#FFFFFF) style=title} @Home/0/0/2/0/0/0:HeroCard/0/0 <HeroCard>
                  text "Upload your ID and business documents to unlock rental access." {color=on_dark_muted(#D8E6E2) style=caption} @Home/0/0/2/0/0/0:HeroCard/0/1 <HeroCard>
                row {distribute=end width=fill} @Home/0/0/2/0/0/0:HeroCard/1 <HeroCard>
                  stack {align=center background=surface(#FFFFFF) height=34 radius=sm(10) width=34} @Home/0/0/2/0/0/0:HeroCard/1/0 <HeroCard>
                    icon "Icons/arrow_right.svg" {color=text(#143132) size=18} @Home/0/0/2/0/0/0:HeroCard/1/0/0 <HeroCard>
            column {background=hero_alt(#545454) distribute=between height=150 padding=md(12) radius=xl(28) width=220} @Home/0/0/2/0/1:HeroCard <HeroCard>
              column {gap=xs(4)} @Home/0/0/2/0/1:HeroCard/0 <HeroCard>
                text "Payments overdue" {color=on_dark(#FFFFFF) style=title} @Home/0/0/2/0/1:HeroCard/0/0 <HeroCard>
                text "40 000 Ft for your Duotts C29 Max was due on 12 Nov. Pay now to keep riding." {color=on_dark_muted(#D8E6E2) style=caption} @Home/0/0/2/0/1:HeroCard/0/1 <HeroCard>
              row {distribute=end width=fill} @Home/0/0/2/0/1:HeroCard/1 <HeroCard>
                stack {align=center background=surface(#FFFFFF) height=34 radius=sm(10) width=34} @Home/0/0/2/0/1:HeroCard/1/0 <HeroCard>
                  icon "Icons/arrow_right.svg" {color=text(#143132) size=18} @Home/0/0/2/0/1:HeroCard/1/0/0 <HeroCard>
        card {background=surface(#FFFFFF) elevation=0 gap=lg(20) padding=lg(20) radius=xl(28)} @Home/0/0/3
          row {align=center width=fill} @Home/0/0/3/0
            column {gap=sm(8) width=fill} @Home/0/0/3/0/0
              row {align=center background=info_soft(#E6EEF4) gap=sm(8) padding_x=md(12) padding_y=xs(4) radius=pill(999)} @Home/0/0/3/0/0/0:StatusPill <StatusPill>
                stack {background=info(#0B71D7) height=8 radius=pill(999) width=8} @Home/0/0/3/0/0/0:StatusPill/0 <StatusPill>
                text "Waiting pickup" {color=info(#0B71D7) style=caption_strong} @Home/0/0/3/0/0/0:StatusPill/1 <StatusPill>
              text "Duotts" {color=accent(#00D9A4) style=body} @Home/0/0/3/0/0/1
              text "C29 Max" {color=hero(#0C473E) style=heading} @Home/0/0/3/0/0/2
            image "Images/bike.png" {fit=contain height=90 width=139} @Home/0/0/3/0/1
          column {background=background(#F7FAF7) padding=md(12) radius=md(16) width=fill} @Home/0/0/3/1
            text "Pickup appointment: Sat 14 Nov, 11:30 confirmed." {color=text(#143132) style=body} @Home/0/0/3/1/0
          row {gap=sm(8) width=fill} @Home/0/0/3/2
            button "Show pickup QR" {background=primary(#00E6B5) padding_x=md(12) padding_y=md(12) radius=md(16) style=button text_color=on_primary(#143132) width=fill} @Home/0/0/3/2/0:AppButton <AppButton>
            button "Directions" {background=surface(#FFFFFF) border_color=border(#EEF2EE) border_width=thin(1) padding_x=md(12) padding_y=md(12) radius=md(16) style=button text_color=text(#143132) width=fill} @Home/0/0/3/2/1:AppButton <AppButton>
        card {background=surface(#FFFFFF) elevation=0 gap=lg(20) padding=lg(20) radius=xl(28)} @Home/0/0/4
          row {width=fill} @Home/0/0/4/0
            column {gap=xs(4) width=fill} @Home/0/0/4/0/0
              text "Distance ridden" {color=text(#143132) style=title_lg} @Home/0/0/4/0/0/0
              text "Last 6 months, from your bike’s GPS" {color=muted(#667370) style=caption} @Home/0/0/4/0/0/1
            stack {align=center background=mint_soft(#EBFEFA) height=36 radius=md(16) width=36} @Home/0/0/4/0/1
              icon "Icons/arrow_right.svg" {color=secondary(#005B45) size=18} @Home/0/0/4/0/1/0
          row {align=center gap=md(12)} @Home/0/0/4/1
            text "1 284 km" {color=text(#143132) style=heading} @Home/0/0/4/1/0
            text "6-month total" {color=accent(#00D9A4) style=caption} @Home/0/0/4/1/1
          row {align=end gap=sm(8) height=150 width=fill} @Home/0/0/4/2
            column {align=center gap=sm(8) width=fill} @Home/0/0/4/2/0:Bar <Bar>
              stack {background=bar(#E3E9E3) height=78 radius=md(16) width=fill} @Home/0/0/4/2/0:Bar/0 <Bar>
              text "Jun" {color=muted(#667370) style=caption} @Home/0/0/4/2/0:Bar/1 <Bar>
            column {align=center gap=sm(8) width=fill} @Home/0/0/4/2/1:Bar <Bar>
              stack {background=bar(#E3E9E3) height=45 radius=md(16) width=fill} @Home/0/0/4/2/1:Bar/0 <Bar>
              text "Jul" {color=muted(#667370) style=caption} @Home/0/0/4/2/1:Bar/1 <Bar>
            column {align=center gap=sm(8) width=fill} @Home/0/0/4/2/2:Bar <Bar>
              row {background=ink(#000000) padding_x=xs(4) padding_y=xs(4) radius=pill(999)} @Home/0/0/4/2/2/slot/0:Tooltip <Tooltip>
                text "312 km" {color=on_dark(#FFFFFF) max_lines=1 style=caption_strong} @Home/0/0/4/2/2/slot/0:Tooltip/0 <Tooltip>
              stack {background=primary(#00E6B5) height=96 radius=md(16) width=fill} @Home/0/0/4/2/2:Bar/1 <Bar>
              text "Aug" {color=muted(#667370) style=caption} @Home/0/0/4/2/2:Bar/2 <Bar>
            column {align=center gap=sm(8) width=fill} @Home/0/0/4/2/3:Bar <Bar>
              stack {background=bar(#E3E9E3) height=75 radius=md(16) width=fill} @Home/0/0/4/2/3:Bar/0 <Bar>
              text "Sep" {color=muted(#667370) style=caption} @Home/0/0/4/2/3:Bar/1 <Bar>
            column {align=center gap=sm(8) width=fill} @Home/0/0/4/2/4:Bar <Bar>
              stack {background=bar(#E3E9E3) height=48 radius=md(16) width=fill} @Home/0/0/4/2/4:Bar/0 <Bar>
              text "Oct" {color=muted(#667370) style=caption} @Home/0/0/4/2/4:Bar/1 <Bar>
    row {align=center background=surface(#FFFFFF) padding_x=sm(8) padding_y=sm(8) width=fill} @Home/1
      column {align=center gap=xs(4) width=fill} @Home/1/0:NavItem <NavItem>
        stack {align=center background=mint_soft(#EBFEFA) height=36 radius=md(16) width=44} @Home/1/0:NavItem/0 <NavItem>
          icon "Icons/home.svg" {color=secondary(#005B45) size=22} @Home/1/0:NavItem/0/0 <NavItem>
        text "Overview" {color=muted(#667370) style=caption} @Home/1/0:NavItem/1 <NavItem>
      column {align=center gap=xs(4) width=fill} @Home/1/1:NavItem <NavItem>
        stack {align=center background=none height=36 radius=md(16) width=44} @Home/1/1:NavItem/0 <NavItem>
          icon "Icons/bike.svg" {color=muted(#667370) size=22} @Home/1/1:NavItem/0/0 <NavItem>
        text "My Rentals" {color=muted(#667370) style=caption} @Home/1/1:NavItem/1 <NavItem>
      stack {align=center background=primary(#00E6B5) elevation=md(8) height=60 position=relative radius=pill(999) top=-18 width=60} @Home/1/2
        icon "Icons/plus.svg" {color=text(#143132) size=26} @Home/1/2/0
      column {align=center gap=xs(4) width=fill} @Home/1/3:NavItem <NavItem>
        stack {align=center background=none height=36 radius=md(16) width=44} @Home/1/3:NavItem/0 <NavItem>
          icon "Icons/box.svg" {color=muted(#667370) size=22} @Home/1/3:NavItem/0/0 <NavItem>
        text "Courier+" {color=muted(#667370) style=caption} @Home/1/3:NavItem/1 <NavItem>
      column {align=center gap=xs(4) width=fill} @Home/1/4:NavItem <NavItem>
        stack {align=center background=none height=36 radius=md(16) width=44} @Home/1/4:NavItem/0 <NavItem>
          icon "Icons/user.svg" {color=muted(#667370) size=22} @Home/1/4:NavItem/0/0 <NavItem>
        text "Profile" {color=muted(#667370) style=caption} @Home/1/4:NavItem/1 <NavItem>
screen Menu title="Menu" background=background(#F7FAF7)
  scroll {background=background(#F7FAF7) direction=vertical height=fill width=fill} @Menu:Page <Page>
    column {gap=lg(20) padding=lg(20) width=fill} @Menu:Page/0 <Page>
      stack {align=center background=surface(#FFFFFF) elevation=sm(2) height=44 on_press=[back] radius=md(16) width=44} @Menu:Page/0/0:IconTile <Page>IconTile>
        icon "Icons/arrow_left.svg" {color=text(#143132) size=20} @Menu:Page/0/0:IconTile/0 <Page>IconTile>
      text "Menu" {color=text(#143132) style=display} @Menu/slot/0
      card {background=surface(#FFFFFF) elevation=0 on_press=[go VerifyCode] padding=lg(20) radius=xl(28)} @Menu/slot/1
        row {align=center gap=md(12) width=fill} @Menu/slot/1/0
          stack {align=center background=mint(#DCFBF1) height=52 radius=pill(999) width=52} @Menu/slot/1/0/0
            text "RR" {color=secondary(#005B45) style=title_lg} @Menu/slot/1/0/0/0
          column {gap=xs(4) width=fill} @Menu/slot/1/0/1
            text "Rehan Raihan" {color=text(#143132) style=title} @Menu/slot/1/0/1/0
            text "rehan@company.com" {color=muted(#667370) style=body} @Menu/slot/1/0/1/1
            row {align=center gap=sm(8) visible=Session.needs_verification} @Menu/slot/1/0/1/2
              stack {background=warning(#F5A623) height=8 radius=pill(999) width=8} @Menu/slot/1/0/1/2/0
              text "Verify your identity to rent" {color=warning_text(#A15C00) style=caption_strong} @Menu/slot/1/0/1/2/1
          icon "Icons/chevron_right.svg" {color=muted(#667370) size=20} @Menu/slot/1/0/2
      text "Rent & ride" {color=muted(#667370) style=subhead} @Menu/slot/2
      row {gap=sm(8) width=fill} @Menu/slot/3
        column {align=center gap=md(12) width=fill} @Menu/slot/3/0:MenuTile <MenuTile>
          image "Images/rentals.png" {fit=contain height=38 width=48} @Menu/slot/3/0:MenuTile/0 <MenuTile>
          row {align=center gap=xs(4)} @Menu/slot/3/0:MenuTile/1 <MenuTile>
            text "My rentals" {color=text(#143132) style=label} @Menu/slot/3/0:MenuTile/1/0 <MenuTile>
        column {align=center gap=md(12) width=fill} @Menu/slot/3/1:MenuTile <MenuTile>
          image "Images/service.png" {fit=contain height=38 width=48} @Menu/slot/3/1:MenuTile/0 <MenuTile>
          row {align=center gap=xs(4)} @Menu/slot/3/1:MenuTile/1 <MenuTile>
            text "Service & repair" {color=text(#143132) style=label} @Menu/slot/3/1:MenuTile/1/0 <MenuTile>
        column {align=center gap=md(12) width=fill} @Menu/slot/3/2:MenuTile <MenuTile>
          image "Images/courier.png" {fit=contain height=38 width=48} @Menu/slot/3/2:MenuTile/0 <MenuTile>
          row {align=center gap=xs(4)} @Menu/slot/3/2:MenuTile/1 <MenuTile>
            text "Courier+" {color=text(#143132) style=label} @Menu/slot/3/2:MenuTile/1/0 <MenuTile>
      text "Money & documents" {color=muted(#667370) style=subhead} @Menu/slot/4
      row {gap=sm(8) width=fill} @Menu/slot/5
        column {align=center gap=md(12) width=fill} @Menu/slot/5/0:MenuTile <MenuTile>
          image "Images/payments.png" {fit=contain height=38 width=48} @Menu/slot/5/0:MenuTile/0 <MenuTile>
          row {align=center gap=xs(4)} @Menu/slot/5/0:MenuTile/1 <MenuTile>
            text "Payments" {color=text(#143132) style=label} @Menu/slot/5/0:MenuTile/1/0 <MenuTile>
        column {align=center gap=md(12) width=fill} @Menu/slot/5/1:MenuTile <MenuTile>
          image "Images/invoices.png" {fit=contain height=38 width=48} @Menu/slot/5/1:MenuTile/0 <MenuTile>
          row {align=center gap=xs(4)} @Menu/slot/5/1:MenuTile/1 <MenuTile>
            text "Invoices" {color=text(#143132) style=label} @Menu/slot/5/1:MenuTile/1/0 <MenuTile>
        column {align=center gap=md(12) width=fill} @Menu/slot/5/2:MenuTile <MenuTile>
          image "Images/documents.png" {fit=contain height=38 width=48} @Menu/slot/5/2:MenuTile/0 <MenuTile>
          row {align=center gap=xs(4)} @Menu/slot/5/2:MenuTile/1 <MenuTile>
            text "Documents" {color=text(#143132) style=label} @Menu/slot/5/2:MenuTile/1/0 <MenuTile>
            stack {align=center background=warning(#F5A623) height=22 radius=pill(999) width=22} @Menu/slot/5/2/slot/0:Badge <Badge>
              text "1" {color=text(#143132) style=badge} @Menu/slot/5/2/slot/0:Badge/0 <Badge>
      text "Account" {color=muted(#667370) style=subhead} @Menu/slot/6
      card {background=surface(#FFFFFF) elevation=0 gap=0 padding=md(12) padding_x=lg(20) padding_y=xs(4) radius=xl(28)} @Menu/slot/7
        row {align=center gap=md(12) padding_y=md(12) width=fill} @Menu/slot/7/0:SettingsRow <SettingsRow>
          stack {align=center background=background(#F7FAF7) height=44 radius=md(16) width=44} @Menu/slot/7/0:SettingsRow/0 <SettingsRow>
            icon "Icons/user.svg" {color=secondary(#005B45) size=22} @Menu/slot/7/0:SettingsRow/0/0 <SettingsRow>
          column {gap=xs(4) width=fill} @Menu/slot/7/0:SettingsRow/1 <SettingsRow>
            text "Profile & settings" {color=text(#143132) style=title} @Menu/slot/7/0:SettingsRow/1/0 <SettingsRow>
            text "Personal details, password, Face ID" {color=muted(#667370) style=caption} @Menu/slot/7/0:SettingsRow/1/1 <SettingsRow>
          icon "Icons/chevron_right.svg" {color=muted(#667370) size=20} @Menu/slot/7/0:SettingsRow/2 <SettingsRow>
        divider {color=border(#EEF2EE) thickness=1} @Menu/slot/7/1
        row {align=center gap=md(12) padding_y=md(12) width=fill} @Menu/slot/7/2:SettingsRow <SettingsRow>
          stack {align=center background=background(#F7FAF7) height=44 radius=md(16) width=44} @Menu/slot/7/2:SettingsRow/0 <SettingsRow>
            icon "Icons/info.svg" {color=secondary(#005B45) size=22} @Menu/slot/7/2:SettingsRow/0/0 <SettingsRow>
          column {gap=xs(4) width=fill} @Menu/slot/7/2:SettingsRow/1 <SettingsRow>
            text "Help & support" {color=text(#143132) style=title} @Menu/slot/7/2:SettingsRow/1/0 <SettingsRow>
            text "Chat with us or report a problem" {color=muted(#667370) style=caption} @Menu/slot/7/2:SettingsRow/1/1 <SettingsRow>
          icon "Icons/chevron_right.svg" {color=muted(#667370) size=20} @Menu/slot/7/2:SettingsRow/2 <SettingsRow>
        divider {color=border(#EEF2EE) thickness=1} @Menu/slot/7/3
        row {align=center gap=md(12) padding_y=md(12) width=fill} @Menu/slot/7/4:SettingsRow <SettingsRow>
          stack {align=center background=background(#F7FAF7) height=44 radius=md(16) width=44} @Menu/slot/7/4:SettingsRow/0 <SettingsRow>
            icon "Icons/document.svg" {color=secondary(#005B45) size=22} @Menu/slot/7/4:SettingsRow/0/0 <SettingsRow>
          column {gap=xs(4) width=fill} @Menu/slot/7/4:SettingsRow/1 <SettingsRow>
            text "Terms & privacy" {color=text(#143132) style=title} @Menu/slot/7/4:SettingsRow/1/0 <SettingsRow>
            text "Rental terms and how we use your data" {color=muted(#667370) style=caption} @Menu/slot/7/4:SettingsRow/1/1 <SettingsRow>
          icon "Icons/chevron_right.svg" {color=muted(#667370) size=20} @Menu/slot/7/4:SettingsRow/2 <SettingsRow>
      column {align=center gap=md(12) padding_y=lg(20) width=fill} @Menu/slot/8
        text "Sign out" {color=danger(#D93036) on_press=[Session.sign_out then go Splash] style=title} @Menu/slot/8/0
        text "E-Renty · version 1.0" {color=muted(#667370) style=caption} @Menu/slot/8/1
screen Splash title="E-Renty" background=background(#F7FAF7)
  stack {align=center background=brand(#01EDB9) height=fill on_press=[go Home] width=fill} @Splash
    image "Images/logo.png" {fit=contain height=32 width=212} @Splash/0
screen VerifyCode title="Verify code" background=background(#F7FAF7)
  scroll {background=surface(#FFFFFF) direction=vertical height=fill width=fill} @VerifyCode:Page <Page>
    column {gap=lg(20) padding=lg(20) width=fill} @VerifyCode:Page/0 <Page>
      stack {align=center background=surface(#FFFFFF) elevation=sm(2) height=44 on_press=[back] radius=md(16) width=44} @VerifyCode:Page/0/0:IconTile <Page>IconTile>
        icon "Icons/arrow_left.svg" {color=text(#143132) size=20} @VerifyCode:Page/0/0:IconTile/0 <Page>IconTile>
      column {align=center gap=md(12) padding_top=xl(32) width=fill} @VerifyCode/slot/0
        image "Images/code.png" {fit=contain height=53 width=75} @VerifyCode/slot/0/0
        text "Enter your code" {align=center color=text(#143132) style=heading} @VerifyCode/slot/0/1
        text "We sent a 6-digit code to your email. Enter it to activate your account." {align=center color=muted(#667370) style=body} @VerifyCode/slot/0/2
      row {distribute=center gap=md(12) padding_y=xl(32) width=fill} @VerifyCode/slot/1
        row {align=center background=background(#F7FAF7) border_color=focus(#5BE39C) border_width=thick(2) gap=lg(20) padding_x=lg(20) padding_y=md(12) radius=lg(22)} @VerifyCode/slot/1/0:OtpGroup <OtpGroup>
          text "4" {color=text(#143132) style=code} @VerifyCode/slot/1/0/slot/0
          text "–" {color=placeholder(#C1CAC8) style=code} @VerifyCode/slot/1/0/slot/1
          text "–" {color=placeholder(#C1CAC8) style=code} @VerifyCode/slot/1/0/slot/2
        row {align=center background=surface(#FFFFFF) border_color=border(#EEF2EE) border_width=thin(1) gap=lg(20) padding_x=lg(20) padding_y=md(12) radius=lg(22)} @VerifyCode/slot/1/1:OtpGroup <OtpGroup>
          text "–" {color=placeholder(#C1CAC8) style=code} @VerifyCode/slot/1/1/slot/0
          text "–" {color=placeholder(#C1CAC8) style=code} @VerifyCode/slot/1/1/slot/1
          text "–" {color=placeholder(#C1CAC8) style=code} @VerifyCode/slot/1/1/slot/2
      row {distribute=center gap=xs(4) padding_bottom=lg(20) padding_top=xl(32) width=fill} @VerifyCode/slot/2
        text "Didn’t get a code?" {color=muted(#667370) style=body} @VerifyCode/slot/2/0
        text "Resend in 0:42" {color=secondary(#005B45) style=body_strong} @VerifyCode/slot/2/1
      button "Verify" {background=disabled(#E3E9E3) on_press=[Session.verify then back] padding_x=md(12) padding_y=md(12) radius=md(16) style=button text_color=muted(#667370) width=fill} @VerifyCode/slot/3:AppButton <AppButton>
      text "Change email" {align=center color=secondary(#005B45) style=body_strong width=fill} @VerifyCode/slot/4
stores
  store Session
    state verified: bool = false
    state needs_verification: bool = true
    action verify [set verified = true; set needs_verification = false]
    action sign_out [set verified = false; set needs_verification = true]
