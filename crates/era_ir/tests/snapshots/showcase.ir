app "ERA Showcase" id=dev.era.showcase version=0.1.0 start=Home
data Products (Data/products.json) 3 rows [name:text photo:text popular:bool price:number]
skin Studio
  colors background=#FFFFFF border=#E8E8E8 danger=#E5484D muted=#737373 on_primary=#FFFFFF primary=#FF6B35 secondary=#2B2D42 success=#2E9E5B surface=#F7F7F7 text=#171717 warning=#F2A93B
  spacing lg=24 md=16 sm=8 xl=32 xs=4
  radius lg=22 md=14 pill=999 sm=8
  border thick=2 thin=1
  elevation lg=12 md=4 sm=1
  font "system" files=[]
  style body size=16 weight=400 line_height=24
  style caption size=13 weight=500 line_height=18
  style display size=40 weight=700 line_height=46 tracking=-0.5
  style heading size=28 weight=700 line_height=34
  style title size=20 weight=600 line_height=26
screen Home title="Home" background=background(#FFFFFF)
  scroll {direction=vertical height=fill width=fill} @Home:MainLayout <MainLayout>
    column {background=background(#FFFFFF) gap=lg(24) padding=lg(24)} @Home:MainLayout/0 <MainLayout>
      text "Design starts here" {color=text(#171717) style=display} @Home:MainLayout/0/0 <MainLayout>
      text "A native interface built with ERA" {color=muted(#737373) style=title} @Home/slot/0
      card {background=surface(#F7F7F7) elevation=sm(1) gap=sm(8) padding=md(16) radius=md(14)} @Home/slot/1
        text "Display" {color=text(#171717) style=display} @Home/slot/1/0
        text "Heading" {color=text(#171717) style=heading} @Home/slot/1/1
        text "Title" {color=text(#171717) style=title} @Home/slot/1/2
        text "Body text reads comfortably at 16 sp." {color=text(#171717) style=body} @Home/slot/1/3
        text "Caption" {color=muted(#737373) style=caption} @Home/slot/1/4
      text "Palette" {color=text(#171717) style=heading} @Home/slot/2
      grid {columns=4 gap=md(16)} @Home/slot/3
        column {gap=xs(4)} @Home/slot/3/0:Swatch <Swatch>
          stack {background=primary(#FF6B35) border_color=border(#E8E8E8) border_width=thin(1) height=64 radius=md(14) width=64} @Home/slot/3/0:Swatch/0 <Swatch>
          text "primary" {color=muted(#737373) style=caption} @Home/slot/3/0:Swatch/1 <Swatch>
        column {gap=xs(4)} @Home/slot/3/1:Swatch <Swatch>
          stack {background=secondary(#2B2D42) border_color=border(#E8E8E8) border_width=thin(1) height=64 radius=md(14) width=64} @Home/slot/3/1:Swatch/0 <Swatch>
          text "secondary" {color=muted(#737373) style=caption} @Home/slot/3/1:Swatch/1 <Swatch>
        column {gap=xs(4)} @Home/slot/3/2:Swatch <Swatch>
          stack {background=success(#2E9E5B) border_color=border(#E8E8E8) border_width=thin(1) height=64 radius=md(14) width=64} @Home/slot/3/2:Swatch/0 <Swatch>
          text "success" {color=muted(#737373) style=caption} @Home/slot/3/2:Swatch/1 <Swatch>
        column {gap=xs(4)} @Home/slot/3/3:Swatch <Swatch>
          stack {background=danger(#E5484D) border_color=border(#E8E8E8) border_width=thin(1) height=64 radius=md(14) width=64} @Home/slot/3/3:Swatch/0 <Swatch>
          text "danger" {color=muted(#737373) style=caption} @Home/slot/3/3:Swatch/1 <Swatch>
      text "Media" {color=text(#171717) style=heading} @Home/slot/4
      row {align=center gap=md(16)} @Home/slot/5
        image "Images/hero.png" {clip=true fit=cover height=96 radius=lg(22) width=96} @Home/slot/5/0
        column {gap=xs(4)} @Home/slot/5/1
          row {gap=xs(4)} @Home/slot/5/1/0
            icon "Icons/star.svg" {color=primary(#FF6B35) size=20} @Home/slot/5/1/0/0
            text "Featured" {color=text(#171717) style=title} @Home/slot/5/1/0/1
          text "Images and icons come from Assets/" {color=muted(#737373) style=caption} @Home/slot/5/1/1
      divider {color=border(#E8E8E8) thickness=1} @Home/slot/6
      text "Buttons" {color=text(#171717) style=heading} @Home/slot/7
      row {align=center gap=sm(8)} @Home/slot/8
        button "Solid" {background=primary(#FF6B35) padding_x=lg(24) padding_y=sm(8) radius=pill(999) style=body text_color=on_primary(#FFFFFF)} @Home/slot/8/0:AppButton <AppButton>
        button "Outline" {background=none border_color=primary(#FF6B35) border_width=thin(1) padding_x=lg(24) padding_y=sm(8) radius=pill(999) style=body text_color=primary(#FF6B35)} @Home/slot/8/1:AppButton <AppButton>
        button "Ghost" {background=none padding_x=lg(24) padding_y=sm(8) radius=pill(999) style=body text_color=primary(#FF6B35)} @Home/slot/8/2:AppButton <AppButton>
      button "Get started" {background=primary(#FF6B35) padding_x=xl(32) padding_y=md(16) radius=pill(999) style=body text_color=on_primary(#FFFFFF)} @Home/slot/9:AppButton <AppButton>
      text "Interactions" {color=text(#171717) style=heading} @Home/slot/10
      text "Tapped {Counter.count} times" {color=text(#171717) style=title} @Home/slot/11
      row {gap=sm(8)} @Home/slot/12
        button "+1" {background=primary(#FF6B35) on_press=[Counter.increment] padding_x=lg(24) padding_y=sm(8) radius=pill(999) style=body text_color=on_primary(#FFFFFF)} @Home/slot/12/0:AppButton <AppButton>
        button "Reset" {background=none border_color=primary(#FF6B35) border_width=thin(1) on_press=[Counter.reset] padding_x=lg(24) padding_y=sm(8) radius=pill(999) style=body text_color=primary(#FF6B35)} @Home/slot/12/1:AppButton <AppButton>
        button "Details" {background=none on_press=[Counter.toggle_details] padding_x=lg(24) padding_y=sm(8) radius=pill(999) style=body text_color=primary(#FF6B35)} @Home/slot/12/2:AppButton <AppButton>
      input {background=surface(#F7F7F7) bind=Counter.name border_color=border(#E8E8E8) border_width=thin(1) padding=sm(8) placeholder="Your name" radius=sm(8) style=body text_color=text(#171717) width=fill} @Home/slot/13
      text "Hello, {Counter.name}! Braces need doubling: {{like this}}." {color=muted(#737373) style=body visible=Counter.details} @Home/slot/14
screen Layout title="CSS layout" background=background(#FFFFFF)
  scroll {direction=vertical height=fill width=fill} @Layout
    column {gap=16 padding_bottom=24 padding_end=16 padding_start=16 padding_top=24 width=100%} @Layout/0
      text "CSS layout" {color=text(#171717) style=display} @Layout/0/0
      row {gap=8} @Layout/0/1
        stack {background=primary(#FF6B35) height=48 radius=8 width=25%} @Layout/0/1/0
        stack {background=secondary(#2B2D42) height=48 radius=8 width=1fr} @Layout/0/1/1
        stack {background=success(#2E9E5B) height=48 radius=8 width=2fr} @Layout/0/1/2
      column {border_color=border(#E8E8E8) border_style=solid border_width=1 margin_bottom=0 margin_end=auto margin_start=auto margin_top=0 padding=12 radius=12 width=200} @Layout/0/2
        text "margin: 0 auto" {align=center color=text(#171717) style=body width=100%} @Layout/0/2/0
      card {background=surface(#F7F7F7) elevation=sm(1) padding=20 position=relative radius=md(14)} @Layout/0/3
        text "Card with a badge" {color=text(#171717) style=body} @Layout/0/3/0
        stack {align=center background=danger(#E5484D) height=28 position=absolute radius=999 right=-8 top=-8 width=28 z_index=2} @Layout/0/3/1
          text "3" {color=on_primary(#FFFFFF) style=caption} @Layout/0/3/1/0
      row {flex_wrap=wrap gap=8} @Layout/0/4
        text "Kotlin" {border_color=border(#E8E8E8) border_style=solid border_width=1 color=text(#171717) padding_bottom=6 padding_end=12 padding_start=12 padding_top=6 radius=999 style=body} @Layout/0/4/0
        text "Compose" {border_color=border(#E8E8E8) border_style=solid border_width=1 color=text(#171717) padding_bottom=6 padding_end=12 padding_start=12 padding_top=6 radius=999 style=body} @Layout/0/4/1
        text "Rust" {border_color=border(#E8E8E8) border_style=solid border_width=1 color=text(#171717) padding_bottom=6 padding_end=12 padding_start=12 padding_top=6 radius=999 style=body} @Layout/0/4/2
        text "Design tokens" {border_color=border(#E8E8E8) border_style=solid border_width=1 color=text(#171717) padding_bottom=6 padding_end=12 padding_start=12 padding_top=6 radius=999 style=body} @Layout/0/4/3
        text "Native UI" {border_color=border(#E8E8E8) border_style=solid border_width=1 color=text(#171717) padding_bottom=6 padding_end=12 padding_start=12 padding_top=6 radius=999 style=body} @Layout/0/4/4
        text "No WebView" {border_color=border(#E8E8E8) border_style=solid border_width=1 color=text(#171717) padding_bottom=6 padding_end=12 padding_start=12 padding_top=6 radius=999 style=body} @Layout/0/4/5
      row {align=center gap=12} @Layout/0/5
        image "Images/hero.png" {aspect_ratio=1.7777777777777777 clip=true fit=cover radius=12 width=30vw} @Layout/0/5/0
        image "Images/hero.png" {aspect_ratio=1 clip=true fit=cover opacity=0.5 radius=999 width=64} @Layout/0/5/1
      row {distribute=between flex_direction=row-reverse} @Layout/0/6
        text "last in source" {color=text(#171717) style=body} @Layout/0/6/1
        text "first in source" {color=text(#171717) style=body} @Layout/0/6/0
      spacer {size=72} @Layout/0/7
      stack {align=center background=primary(#FF6B35) bottom=24 elevation=md(4) height=56 position=fixed radius=999 right=20 width=56} @Layout/0/8
        text "+" {color=on_primary(#FFFFFF) style=heading} @Layout/0/8/0
screen Look title="CSS look" background=background(#FFFFFF)
  scroll {direction=vertical height=fill width=fill} @Look
    column {gap=16 padding_bottom=24 padding_end=16 padding_start=16 padding_top=24 width=100%} @Look/0
      text "CSS look" {color=text(#171717) style=display} @Look/0/0
      row {gap=12} @Look/0/1
        column {align=center border_color=primary(#FF6B35) border_style=dashed border_width=2 distribute=center flex=1 height=64 radius=12} @Look/0/1/0
          text "dashed" {color=text(#171717) style=body} @Look/0/1/0/0
        column {align=center border_color=secondary(#2B2D42) border_style=dotted border_width=3 distribute=center flex=1 height=64 radius=12} @Look/0/1/1
          text "dotted" {color=text(#171717) style=body} @Look/0/1/1/0
      column {background=surface(#F7F7F7) border_bottom_color=border(#E8E8E8) border_bottom_style=dashed border_bottom_width=1 border_start_color=primary(#FF6B35) border_start_style=solid border_start_width=4 padding_bottom=12 padding_end=16 padding_start=16 padding_top=12} @Look/0/2
        text "border-left + border-bottom" {color=text(#171717) style=body} @Look/0/2/0
      row {gap=12} @Look/0/3
        stack {background=primary(#FF6B35) height=72 radius_bottom_end=24 radius_bottom_start=0 radius_top_end=0 radius_top_start=24 width=72} @Look/0/3/0
        stack {background=secondary(#2B2D42) height=72 radius=50% width=72} @Look/0/3/1
        stack {background=success(#2E9E5B) height=72 radius_bottom_end=8 radius_top_start=36 width=72} @Look/0/3/2
      row {gap=8} @Look/0/4
        stack {background=#FF6347 flex=1 height=40 radius=8} @Look/0/4/0
        stack {background=#1E90FF flex=1 height=40 radius=8} @Look/0/4/1
        stack {background=#A347D1 flex=1 height=40 radius=8} @Look/0/4/2
        stack {background=#00000059 flex=1 height=40 radius=8} @Look/0/4/3
        stack {background=primary(#FF6B35) flex=1 height=40 radius=8} @Look/0/4/4
      column {background=linear(135deg, #FF6B35 0%, #F7C548 60%, #33CC80 100%) distribute=end height=120 padding=20 radius=20 width=100%} @Look/0/5
        text "linear-gradient(135deg, …)" {color=#FFFFFF style=body} @Look/0/5/0
      row {gap=12} @Look/0/6
        stack {background=linear(to top right, #663399 0%, #FF1493 100%) flex=1 height=96 radius=16} @Look/0/6/0
        stack {background=radial(circle, #FFFFFF 0%, #FFD700 40%, #FF8C00 100%) height=96 radius=50% width=96} @Look/0/6/1
      column {background=linear(90deg, #FFFFFF00 0%, #FFFFFFE6 100%) | #008080 height=64 radius=16 width=100%} @Look/0/7
      row {gap=16 padding_bottom=12 padding_end=4 padding_start=4 padding_top=12} @Look/0/8
        column {background=#FFFFFF box_shadow=0 8 24 0 #0000002E elevation=0 flex=1 height=80 radius=16} @Look/0/8/0
        column {background=#FFFFFF box_shadow=0 1 2 0 #00000033, 0 12 28 -6 #FF6B3599 elevation=0 flex=1 height=80 radius=16} @Look/0/8/1
        column {background=#EEF1F5 box_shadow=inset 0 3 10 0 #00000040 elevation=0 flex=1 height=80 radius=16} @Look/0/8/2
      row {gap=8} @Look/0/9
        stack {background=linear(90deg, #FF6347 0%, #FFD700 100%) filter=grayscale(1) flex=1 height=56 radius=12} @Look/0/9/0
        stack {background=linear(90deg, #FF6347 0%, #FFD700 100%) filter=hue-rotate(180) flex=1 height=56 radius=12} @Look/0/9/1
        stack {background=linear(90deg, #FF6347 0%, #FFD700 100%) filter=sepia(1) brightness(0.9) flex=1 height=56 radius=12} @Look/0/9/2
        stack {background=linear(90deg, #FF6347 0%, #FFD700 100%) filter=blur(4) flex=1 height=56 radius=12} @Look/0/9/3
      row {padding=8} @Look/0/10
        button "Focused" {background=primary(#FF6B35) outline_color=primary(#FF6B35) outline_offset=4 outline_style=solid outline_width=2 padding_x=md(16) padding_y=sm(8) radius=md(14) style=body text_color=on_primary(#FFFFFF)} @Look/0/10/0
screen Menu title="Menu" background=background(#FFFFFF)
  scroll {direction=vertical height=fill width=fill} @Menu
    column {gap=12 padding_bottom=24 padding_end=16 padding_start=16 padding_top=24 width=100%} @Menu/0
      text "Menu" {color=text(#171717) style=display} @Menu/0/0
      for p in Products @Menu/0/1
        row {align=center background=#FFFFFF box_shadow=0 4 14 0 #00000014 elevation=0 gap=12 padding=12 radius=16 width=100%} @Menu/0/1/0
          image p.photo {fit=cover height=56 radius=12 width=56} @Menu/0/1/0/0
          column {flex=1 gap=2} @Menu/0/1/0/1
            text "{p.name}" {color=text(#171717) style=heading} @Menu/0/1/0/1/0
            text "Popular" {color=primary(#FF6B35) style=body visible=p.popular} @Menu/0/1/0/1/1
          text "${p.price}" {color=secondary(#2B2D42) style=body} @Menu/0/1/0/2
stores
  store Counter
    persist state count: number = 0
    state name: text = ""
    state details: bool = true
    action increment [add count 1]
    action reset [set count = 0]
    action toggle_details [toggle details]
assets
  Icon Icons/star.svg
  Image Images/hero.png
