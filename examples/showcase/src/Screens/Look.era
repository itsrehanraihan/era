// CSS looks (M8 phase 3+): borders, corners and outlines, written the web way.
screen Look {
    title: "CSS look"

    scroll {
        column {
            width: 100%
            padding: 24px 16px
            gap: 16px

            text "CSS look" { style: display }

            // border-style: dashed / dotted
            row {
                gap: 12px
                column { flex: 1; height: 64px; border: 2px dashed primary; border-radius: 12px; justify-content: center; align-items: center
                    text "dashed" }
                column { flex: 1; height: 64px; border: 3px dotted secondary; border-radius: 12px; justify-content: center; align-items: center
                    text "dotted" }
            }

            // Per-side borders
            column {
                padding: 12px 16px
                background: surface
                border-left: 4px solid primary
                border-bottom: 1px dashed border
                text "border-left + border-bottom"
            }

            // Per-corner radius and percentages
            row {
                gap: 12px
                stack { width: 72px; height: 72px; background: primary; border-radius: 24px 0 }
                stack { width: 72px; height: 72px; background: secondary; border-radius: 50% }
                stack { width: 72px; height: 72px; background: success; border-top-left-radius: 36px; border-bottom-right-radius: 8px }
            }

            // Colours: names, rgb(), hsl(), var()
            row {
                gap: 8px
                stack { flex: 1; height: 40px; border-radius: 8px; background: tomato }
                stack { flex: 1; height: 40px; border-radius: 8px; background: rgb(30 144 255) }
                stack { flex: 1; height: 40px; border-radius: 8px; background: hsl(280, 60%, 55%) }
                stack { flex: 1; height: 40px; border-radius: 8px; background: rgba(0, 0, 0, .35) }
                stack { flex: 1; height: 40px; border-radius: 8px; background: var(--primary) }
            }

            // Gradients
            column {
                width: 100%
                height: 120px
                border-radius: 20px
                padding: 20px
                justify-content: flex-end
                background: linear-gradient(135deg, #FF6B35, #F7C548 60%, hsl(150, 60%, 50%))
                text "linear-gradient(135deg, …)" { color: white }
            }
            row {
                gap: 12px
                stack { flex: 1; height: 96px; border-radius: 16px; background: linear-gradient(to top right, rebeccapurple, deeppink) }
                stack { width: 96px; height: 96px; border-radius: 50%; background: radial-gradient(circle, white, gold 40%, darkorange) }
            }
            // Layers: a translucent gradient over a colour
            column {
                width: 100%
                height: 64px
                border-radius: 16px
                background: linear-gradient(to right, rgba(255, 255, 255, 0), rgba(255, 255, 255, .9)), rgb(0 128 128)
            }

            // box-shadow: soft, layered, coloured and inset
            row {
                gap: 16px
                padding: 12px 4px
                column { flex: 1; height: 80px; border-radius: 16px; background: white; box-shadow: 0 8px 24px rgba(0, 0, 0, .18) }
                column { flex: 1; height: 80px; border-radius: 16px; background: white; box-shadow: 0 1px 2px rgba(0, 0, 0, .2), 0 12px 28px -6px rgba(255, 107, 53, .6) }
                column { flex: 1; height: 80px; border-radius: 16px; background: #EEF1F5; box-shadow: inset 0 3px 10px rgba(0, 0, 0, .25) }
            }

            // filter: grayscale, hue-rotate, sepia, blur
            row {
                gap: 8px
                stack { flex: 1; height: 56px; border-radius: 12px; background: linear-gradient(90deg, tomato, gold); filter: grayscale(100%) }
                stack { flex: 1; height: 56px; border-radius: 12px; background: linear-gradient(90deg, tomato, gold); filter: hue-rotate(180deg) }
                stack { flex: 1; height: 56px; border-radius: 12px; background: linear-gradient(90deg, tomato, gold); filter: sepia(1) brightness(.9) }
                stack { flex: 1; height: 56px; border-radius: 12px; background: linear-gradient(90deg, tomato, gold); filter: blur(4px) }
            }

            // outline + outline-offset (takes no space)
            row {
                padding: 8px
                button "Focused" { outline: 2px solid primary; outline-offset: 4px }
            }
        }
    }
}
