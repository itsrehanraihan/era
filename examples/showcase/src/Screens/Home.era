screen Home {
    title: "Home"

    MainLayout {
        heading: "Design starts here"

        text "A native interface built with ERA" { style: title, color: muted }

        // Typography specimen
        card {
            gap: sm
            text "Display" { style: display }
            text "Heading" { style: heading }
            text "Title"   { style: title }
            text "Body text reads comfortably at 16 sp." { style: body }
            text "Caption" { style: caption, color: muted }
        }

        // Skin palette
        text "Palette" { style: heading }
        grid {
            columns: 4
            gap: md
            Swatch { name: "primary",   color: primary }
            Swatch { name: "secondary", color: secondary }
            Swatch { name: "success",   color: success }
            Swatch { name: "danger",    color: danger }
        }

        // Images and icons
        text "Media" { style: heading }
        row {
            gap: md
            align: center
            image "Images/hero.png" { width: 96, height: 96, radius: lg, clip: true }
            column {
                gap: xs
                row {
                    gap: xs
                    icon "Icons/star.svg" { size: 20, color: primary }
                    text "Featured" { style: title }
                }
                text "Images and icons come from Assets/" { style: caption, color: muted }
            }
        }

        divider

        // Button variants
        text "Buttons" { style: heading }
        row {
            gap: sm
            align: center
            AppButton { label: "Solid" }
            AppButton { label: "Outline", tone: outline }
            AppButton { label: "Ghost",   tone: ghost }
        }
        AppButton { label: "Get started", size: large }
    }
}
