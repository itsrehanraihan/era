// Showcase state: a counter (saved on the device), a name typed into an
// input, and a toggle.
store Counter {
    persist state count: number = 0
    state name: text = ""
    state details: bool = true

    action increment {
        add count 1
    }

    action reset {
        set count = 0
    }

    action toggle_details {
        toggle details
    }
}
