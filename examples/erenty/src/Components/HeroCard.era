// Swipeable alert card on the home screen.
component HeroCard {
    prop heading: text
    prop body: text
    variant tone: green | grey = green

    column {
        width: 300
        height: 220
        padding: lg
        radius: xl
        background: hero
        distribute: between

        when tone is grey { background: hero_alt }

        column {
            gap: sm
            text heading { style: title_lg, color: on_dark }
            text body { style: caption, color: on_dark_muted }
        }
        row {
            width: fill
            distribute: end
            stack {
                width: 44
                height: 44
                radius: md
                background: surface
                align: center
                icon "Icons/arrow_right.svg" { size: 18, color: text }
            }
        }
    }
}
