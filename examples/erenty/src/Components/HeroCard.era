// Swipeable alert card on the home screen.
component HeroCard {
    prop heading: text
    prop body: text
    variant tone: green | grey = green

    column {
        width: 220
        height: 150
        padding: md
        radius: xl
        background: hero
        distribute: between

        when tone is grey { background: hero_alt }

        column {
            gap: xs
            text heading { style: title, color: on_dark }
            text body { style: caption, color: on_dark_muted }
        }
        row {
            width: fill
            distribute: end
            stack {
                width: 34
                height: 34
                radius: sm
                background: surface
                align: center
                icon "Icons/arrow_right.svg" { size: 18, color: text }
            }
        }
    }
}
